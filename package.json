{
  "name": "ckeditor5-code-block-syntax-highlight",
  "version": "0.1.0",
  "description": "Live syntax highlighting for CKEditor 5 code blocks, painted with the CSS Custom Highlight API.",
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor5-plugin",
    "code-block",
    "syntax-highlighting",
    "highlight.js"
  ],
  "repository": "https://github.com/Simply007/ckeditor5-code-block-syntax-highlight",
  "author": "CKSource (http://cksource.com/)",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "build:sample": "vite build",
    "prepare": "pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "ckeditor5": "^48.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-core": "48.5.0",
    "@eslint/js": "^10.0.1",
    "ckeditor5": "48.5.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  }
}
